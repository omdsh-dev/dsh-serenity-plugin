{
  "name": "@shgroup/dsh-serenity-hooks",
  "version": "1.31.6",
  "description": "宁静号 ACC harness（Native Cordis 插件）——给 DeepSeek Harness 装一个「AI 工作区」：11 个工具（container_fs/logbook/dashboard/container_git/msm/praxis/handyman/localstore/container_admin/autopilot-trajectory/im-bridge）+ 机械约束（安全模式/工作区围墙/密钥守卫/对外输出守卫）+ 工作日志与原地重建 + 网页登录入口/微信桥/子角色/对外问答页/自主巡航。适配 DSH 0.1.5-rc.1。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellmewhattodo/dsh-serenity-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/invariant.js",
    "lib/*.js",
    "lib/*.d.ts",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "experiments/autopilot-trajectory/SKILL.md",
    "experiments/autopilot-trajectory/scripts/autopilot-trajectory.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepare": "tsdown --config tsdown.prepare.config.ts && tsc -p tsconfig.json --emitDeclarationOnly"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "cordis": "^4.0.2",
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell-env": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-fetch-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode-generator": "^1.0.6",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "marked": "^18.0.11",
    "qrcode-generator": "^2.0.4",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.4.0",
    "unrun": "^0.3.1",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

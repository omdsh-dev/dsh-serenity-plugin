{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-tools": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-tools"],
      "@deepseek-ai/dsh-agent": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-agent"],
      "@deepseek-ai/dsh-agent-presets": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-agent-presets"],
      "@deepseek-ai/dsh-session": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session"],
      "@deepseek-ai/dsh-session/types": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-llm": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-llm"],
      "@deepseek-ai/dsh-host-webserver": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-host-webserver"],
      "@deepseek-ai/dsh-shell-env": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-shell-env"],
      "@deepseek-ai/dsh-shell": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-shell"],
      "@deepseek-ai/dsh-skill": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-skill"],
      "@deepseek-ai/dsh-compaction": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-compaction"],
      "@deepseek-ai/dsh-settings": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-settings"],
      "@deepseek-ai/dsh-session-title": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session-title"],
      "@deepseek-ai/dsh-system-prompt": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-system-prompt"],
      "@deepseek-ai/dsh-agent-loop": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-agent-loop"],
      // v1.31.8：宿主**类型契约**（src/host/type-contract.ts）用真实宿主类型反证 dsp 的形状假设，
      // 需要下列包的类型面进入 program（这些包不在 peerDeps 的必要面里，但装在宿主 node_modules 下）。
      // 新增条目须保持同形（…/@deepseek-ai/dsh/node_modules/@deepseek-ai/<pkg>），
      // 以便 `dsh-develop typecheck-host <ver>` 的路径改写规则能把它们指向 _tmp 解包宿主。
      "@deepseek-ai/dsh-session-persistence": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session-persistence"],
      "@deepseek-ai/dsh-session-projection": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session-projection"],
      // 子路径 `@deepseek-ai/dsh-session-projection/types` 是**多个宿主包共同声明增强**的模块 id
      // （token-meter/subagent/session-title/agent 等 10+ 包往 SessionProjectionMap 里塞自己的键）。
      // 本机安装靠 package.json exports map 解析；`typecheck-host <ver>` 的解包宿主无 node_modules，
      // 必须显式映射到同一文件，否则增强不合并 → `contextPressure` 等键在推导基线里"消失"（假红）。
      "@deepseek-ai/dsh-session-projection/types": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-session-projection/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-token-meter": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-token-meter"],
      "@deepseek-ai/dsh-workspace": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-workspace"],
      "@deepseek-ai/dsh-subagent": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-subagent"],
      "@deepseek-ai/dsh-client-connection": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-connection"],
      // v1.30.12：web_fetch provider 接管（注册进 ctx.web + 复用 HttpFetchProvider）
      "@deepseek-ai/dsh-web": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-web"],
      "@deepseek-ai/dsh-web-fetch-http": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-web-fetch-http"],
      // v1.28.0 适配 0.1.2-rc.1（A1）：dsh-client-runtime 包已删 → Settings* 类型源改
      // dsh-client-ui-settings/client + ui-renderer/client（官方声明合并面）
      "@deepseek-ai/dsh-client-ui-settings": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client/index.d.ts"],
      // v1.31.6 适配 0.1.5-rc.1：session 作用域类型面（SessionStandardProps.sessionId / client Context.sessions）
      // 从 ui-conversation 抽到新包 dsh-client-ui-session；dsp client 半经空类型 import 引入。
      "@deepseek-ai/dsh-client-ui-session": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-session/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-primitives": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-primitives/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-locale": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-client-locale"],
      "cordis": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/cordis": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/cordis"],
      "schemastery": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/schemastery"],
      "@deepseek-ai/schemastery": ["../../../../../../.npm-global/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/schemastery"]
    }
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
